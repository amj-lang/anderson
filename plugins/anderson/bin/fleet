#!/usr/bin/env bash
# fleet — launcher for THE OPERATOR (bin/fleet.py). Picks the right way to start it for
# whatever terminal setup you have; everything else passes through to fleet.py.
#
#   fleet                 run right here, in the current terminal (inside or outside tmux)
#   fleet --tmux          outside tmux: start/attach a tmux session "fleet" (status bar hidden)
#   fleet --pane          inside tmux: open in a 45% side pane
#   fleet --window        inside tmux: open in a new window named "fleet"
#   fleet --here          same as the default; kept for scripts and the prefix+F hotkey
#   fleet install         put a stable `fleet` shim in ~/.local/bin (survives plugin updates)
#   fleet install --with-tmux   same, plus install tmux (brew / apt / dnf) if missing. tmux is
#                         optional: on macOS ⏎ jack-in also works without it (focuses the
#                         iTerm2 / Terminal.app tab that owns the session)
#   fleet install --extras      same, plus the optional tools fleet can use: glow (o renders
#                         markdown) and, on macOS, terminal-notifier (n desktop banners)
#   fleet uninstall       remove that shim
#   fleet --demo | --theme zion | --plain | --calm | --no-intro | --once   -> fleet.py flags
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$here/fleet.py"
bin_dir="${FLEET_BIN_DIR:-$HOME/.local/bin}"
shim="$bin_dir/fleet"

die(){ printf 'fleet: %s\n' "$*" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || die "python3 not found (fleet.py is stdlib python, nothing else to install)"

install_shim(){
  mkdir -p "$bin_dir"
  # Dev checkout (not under the plugin cache): pin to it. Cache install: resolve the newest
  # anderson at run time so plugin updates never break the shim.
  case "$here" in
    "$HOME"/.claude/plugins/cache/*) pinned="" ;;
    *)                                pinned="$here" ;;
  esac
  cat > "$shim" <<EOF
#!/usr/bin/env bash
# fleet shim — installed by \`fleet install\` (anderson plugin). Resolves the launcher at run time.
root="\${ANDERSON_ROOT:-}"
[ -z "\$root" ] && [ -n "$pinned" ] && [ -f "$pinned/fleet" ] && root="$(dirname "$pinned")"
if [ -z "\$root" ]; then
  newest="\$(ls -d "\$HOME"/.claude/plugins/cache/*/anderson/*/ 2>/dev/null | sort -V | tail -1)"
  [ -n "\$newest" ] && root="\${newest%/}"
fi
[ -n "\$root" ] && [ -f "\$root/bin/fleet" ] || { echo "fleet: anderson plugin not found (set ANDERSON_ROOT to its directory)" >&2; exit 1; }
exec bash "\$root/bin/fleet" "\$@"
EOF
  chmod +x "$shim"
  printf 'installed %s\n' "$shim"
  case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) printf 'add to PATH (once):  echo '"'"'export PATH="%s:$PATH"'"'"' >> ~/.zshrc && source ~/.zshrc\n' "$bin_dir" ;;
  esac
  extras_report
  if command -v tmux >/dev/null 2>&1; then
    printf 'optional tmux hotkey (prefix+F):  echo '"'"'bind F split-window -h -l 45%% "%s --here"'"'"' >> ~/.tmux.conf && tmux source ~/.tmux.conf\n' "$shim"
  else
    printf 'tmux not found: optional. without it fleet runs plain, and on macOS ⏎ jack-in focuses the iTerm2/Terminal.app tab.\n'
    printf 'for tmux panes:  fleet install --with-tmux   (runs: %s)\n' "$(tmux_hint)"
  fi
}

# optional tools: name -> what it gives; extras_report prints ✓ / missing + the install line
extra_use(){
  case "$1" in
    glow) echo "o renders plan.md / audit.md as markdown (else less with a light colouring)" ;;
    terminal-notifier) echo "n desktop banners on macOS (osascript banners are unreliable)" ;;
    tmux) echo "panes / windows and ⏎ jack-in by pane" ;;
  esac
}
pkg_hint(){
  if command -v brew >/dev/null 2>&1; then echo "brew install $1"
  elif command -v apt-get >/dev/null 2>&1; then
    case "$1" in glow) echo "see https://github.com/charmbracelet/glow#installation (charm apt repo)" ;; *) echo "sudo apt-get install -y $1" ;; esac
  elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install -y $1"
  else echo "install $1 with your package manager"; fi
}
extras_list(){ echo glow; [ "$(uname -s)" = "Darwin" ] && echo terminal-notifier; return 0; }
extras_report(){
  local missing=0 t
  for t in $(extras_list) tmux; do
    if command -v "$t" >/dev/null 2>&1; then printf 'extras:  ✓ %-18s %s\n' "$t" "$(extra_use "$t")"
    else printf 'extras:  · %-18s %s   →  %s\n' "$t" "$(extra_use "$t")" "$(pkg_hint "$t")"; missing=1; fi
  done
  [ "$missing" -eq 1 ] && printf 'install the missing ones:  fleet install --extras   (glow, terminal-notifier)   ·   fleet install --with-tmux\n'
  return 0
}
install_pkg(){
  command -v "$1" >/dev/null 2>&1 && { printf '%s already installed\n' "$1"; return 0; }
  hint="$(pkg_hint "$1")"
  case "$hint" in
    brew*|sudo*) printf 'installing %s: %s\n' "$1" "$hint"; eval "$hint" || printf 'could not install %s; run it yourself: %s\n' "$1" "$hint" ;;
    *)           printf 'no package for %s here: %s\n' "$1" "$hint" ;;
  esac
}
install_extras(){ for t in $(extras_list); do install_pkg "$t"; done; }

tmux_hint(){
  if command -v brew >/dev/null 2>&1; then echo "brew install tmux"
  elif command -v apt-get >/dev/null 2>&1; then echo "sudo apt-get install -y tmux"
  elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install -y tmux"
  else echo "install tmux with your package manager"; fi
}

install_tmux(){
  command -v tmux >/dev/null 2>&1 && { printf 'tmux already installed\n'; return 0; }
  hint="$(tmux_hint)"
  case "$hint" in
    brew*|sudo*) printf 'installing tmux: %s\n' "$hint"; eval "$hint" ;;
    *)           die "no known package manager; $hint" ;;
  esac
}

case "${1:-}" in
  install)   shift
             for a in "$@"; do
               case "$a" in
                 --with-tmux) install_tmux ;;
                 --extras)    install_extras ;;
                 --all)       install_tmux; install_extras ;;
                 *)           die "unknown install flag: $a  (--extras, --with-tmux, --all)" ;;
               esac
             done
             install_shim; exit 0 ;;
  uninstall) rm -f "$shim" && printf 'removed %s\n' "$shim"; exit 0 ;;
esac

mode="here"
args=()
for a in "$@"; do
  case "$a" in
    --pane)   mode="pane" ;;
    --window) mode="window" ;;
    --tmux)   mode="tmux" ;;
    --here)   mode="here" ;;
    *)        args+=("$a") ;;
  esac
done

cmd="python3 $(printf '%q' "$py")"
for a in "${args[@]+"${args[@]}"}"; do cmd="$cmd $(printf '%q' "$a")"; done

# --once / --selftest / --themes are non-interactive: always run in place.
for a in "${args[@]+"${args[@]}"}"; do
  case "$a" in --once|--selftest|--themes) mode="here" ;; esac
done

if [ "$mode" = "here" ] || ! command -v tmux >/dev/null 2>&1; then
  exec python3 "$py" "${args[@]+"${args[@]}"}"
fi

if [ -n "${TMUX:-}" ]; then
  case "$mode" in
    pane)   exec tmux split-window -h -l 45% "$cmd" ;;
    window) exec tmux new-window -n fleet "$cmd" ;;
    *)      exec python3 "$py" "${args[@]+"${args[@]}"}" ;;
  esac
fi

# Outside tmux: --tmux = one session named "fleet" (created on first run, attached after), its
# status bar off so only the monitor shows. Anything else runs right here.
if [ "$mode" = "tmux" ]; then
  exec tmux new-session -A -s fleet "$cmd" \; set-option status off
fi
exec python3 "$py" "${args[@]+"${args[@]}"}"
