{
  "name": "anderson-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion source for the anderson promo video. `npm run render` writes out/anderson.mp4.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Anderson out/anderson.mp4 --concurrency=4",
    "portrait": "remotion render AndersonPortrait out/anderson-portrait.mp4 --concurrency=4",
    "square": "remotion render AndersonSquare out/anderson-square.mp4 --concurrency=4",
    "still": "remotion still Anderson out/frame.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.395",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.395"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.2"
  }
}
